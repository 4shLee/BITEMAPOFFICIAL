APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Default UTC. Use Asia/Manila for Railway. Choose BEFORE real data exists: changing it later
# reinterprets already-stored timestamps.
APP_TIMEZONE=UTC

# Comma-separated exact origins allowed to call the API from a browser (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex list, e.g. Vercel preview deployments.
# CORS_ALLOWED_ORIGIN_PATTERNS=

# Behind Railway's proxy set to * so client IP / https are detected. Leave unset locally.
# TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SMS reminders are NEVER sent live unless SMS_SERVICE_ENABLED=true (default: false).
# Supported SMS_PROVIDER values: PhilSMS, Semaphore, Twilio, Mock
# Set provider credentials as server environment variables only; never commit them.
# Credentials saved via the Settings screen (plaintext in the DB) are honoured only in
# local/testing unless SMS_ALLOW_DB_CREDENTIALS=true.
SMS_SERVICE_ENABLED=false
# SMS_ALLOW_DB_CREDENTIALS=false
SMS_PROVIDER=Twilio

# PhilSMS (API v3 - primary Philippine SMS gateway)
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS
# PHILSMS_ENDPOINT=https://app.philsms.com/api/v3/sms/send

# Semaphore (API v4 - fallback Philippine SMS gateway)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# SEMAPHORE_ENDPOINT=https://api.semaphore.co/api/v4/messages

# Twilio (legacy / international gateway)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BITEMAP_FACILITY_NAME="Animal Bite Treatment Center"

VITE_APP_NAME="${APP_NAME}"
